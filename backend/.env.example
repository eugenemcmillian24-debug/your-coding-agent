# Database (Supabase)
# Pooler connection (recommended for production — transaction pooling)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-1-us-west-2.pooler.supabase.com:6543/postgres
# Direct connection (for migrations)
DIRECT_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Redis
REDIS_URL=redis://redis:6379/0

# AI Provider
OPENCODE_API_KEY=
OPENCODE_BASE_URL=
OPENCODE_GO_MODEL=
OPENCODE_ZEN_MODEL=
DEFAULT_PROVIDER=opencode-go

# GitHub Integration
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_WEBHOOK_SECRET=

# Cloudflare Integration
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WEBHOOK_SECRET=

# Supabase (optional — for direct Supabase client usage)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Commit Defaults
DEFAULT_COMMIT_NAME=Forge Agent
DEFAULT_COMMIT_EMAIL=forge-agent@example.com
